.champ-row
  %p.champ-label
    = "#{label} :"

  - if blank?
    .champ-content.fr-text-mention--grey{ class: content_class }
      - if usager?
        %p.champ-blank= blank

  - else

    .champ-content{ class: content_class }
      = value

  -# pf: badge "modifié le" sorti du libellé, descendu sous la valeur pour éviter les collisions en colonne étroite (grid instructeur).
  -# Le badge lui-même est le composant upstream (ChampUpdatedComponent, 2025-12-08-01).
  - if updated_at.present?
    .champ-updated-line
      = render Dossiers::ChampUpdatedComponent.new(updated_at:, seen_at:)
