-# pf: shown when the siret champ is in multiple_found state — asks the user to pick one etablissement
- if @etablissements.present?
  %p.fr-info-text= t('.ambiguous_prefix_html')
  %span.fr-text--sm
    = "#{t('.label')} :"
  %ul.fr-text--sm.fr-text-mention--grey.etablissements
    - @etablissements.each do |etablissement|
      - num = etablissement[:num_entreprise] || etablissement['num_entreprise']
      - nom_commercial = etablissement[:entreprise_nom_commercial] || etablissement['entreprise_nom_commercial']
      - raison = etablissement[:entreprise_raison_sociale] || etablissement['entreprise_raison_sociale']
      - localite = etablissement[:localite] || etablissement['localite']
      - full_siret = "#{@siret_prefix}#{sprintf('%03d', num.to_i)}"
      %li.fr-btns-group--sm.fr-btns-group--inline.fr-btns-group--icon-right
        %span
          = "#{sprintf('%03d', num.to_i)} - #{nom_commercial.presence || raison} - #{localite}"
        %a.fr-btn.fr-btn--tertiary{ href: "javascript:void(0)", onclick: "etablissementsList_pick('#{full_siret}', '#{@input_id}')" }
          = t('.select')
  %script{ type: "text/javascript", id: "etablissements-handler-#{@input_id}" }
    :plain
      function etablissementsList_pick(fullSiret, inputId) {
        var input = document.getElementById(inputId);
        if (!input) { return; }
        input.value = fullSiret;
        var event = new Event('input', { bubbles: true, cancelable: true });
        input.dispatchEvent(event);
        var changeEvent = new Event('change', { bubbles: true, cancelable: true });
        input.dispatchEvent(changeEvent);
      }
