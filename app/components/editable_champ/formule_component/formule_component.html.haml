.fr-text.fr-text--lg{ role: "status", "aria-live": "polite", "aria-labelledby": dom_id(@champ, :label) }
  - if @champ.value.present?
    = formatted_value
  - else
    -# pf: marker neutre "—" cohérent avec FormuleTypeDeChamp#champ_value.
    -# L'aria-label reste verbeux et localisé pour les lecteurs d'écran.
    %span.fr-text--mention-grey{ "aria-label": t('.no_value_aria', libelle: @champ.libelle) }
      —
