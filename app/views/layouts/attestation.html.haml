%html{ lang: 'fr' }
  %head
    -# pf: utiliser nom simple en développement pour WeasyPrint
    - if Rails.env.development?
      %link{ href: '/assets/attestation.css', rel: 'stylesheet', media: 'all' }
    - else
      = stylesheet_link_tag 'attestation', media: 'all'
    %title= content_for?(:title) ? yield(:title) : 'Attestation'
    = yield(:authors)
    = yield(:keywords)
    = yield(:description)
    %meta{ name: 'generator', content: ENV.fetch('APP_HOST') }
    %meta{ name: 'dcterms.created', content: Time.zone.now.iso8601 }

  %body#attestation
    = yield
