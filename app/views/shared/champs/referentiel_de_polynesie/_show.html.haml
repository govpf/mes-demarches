- if champ.data.blank?
  = champ.to_s
- else
  .referentiel-champ.fr-mt-1v
    %p.referentiel-champ__header.fr-mb-1w
      %span.fr-text--bold= champ.value
      %span.fr-badge.fr-badge--sm.fr-badge--success.fr-ml-1w Donnée vérifiée du référentiel

    -# pf: mode upstream — colonnes filtrées par la config du champ (referentiel_mapping,
    -# flags display_instructeur / display_usager). Remplace l'ancienne sélection Baserow.
    - if champ.upstream_referentiel_mode?
      .referentiel-columns
        - champ.displayable_columns_for(profile).each do |name, value|
          .referentiel-column
            .champ-label= "#{name} :"
            %p.champ-content.copy-zone.fr-mb-0{ 'data-to-copy': referentiel_de_polynesie_display_value(value) }
              %span{ data: { to_copy: true } }= referentiel_de_polynesie_display_value(value)
              %span{ 'data-copy-message-placeholder': true }
    - else
      -# pf: mode legacy (anciens dossiers table_row_selector) — sélection via config Baserow
      .referentiel-columns
        - data = champ.data
        - row = data.key?('row') ? data['row'] : data
        - fields = data["#{profile}_fields"].presence || row.keys
        - fields.each do |name|
          - value = row.key?(name) ? (row[name] || "") : "Champ #{name} inconnu"
          .referentiel-column
            .champ-label= "#{name} :"
            - case value
              - when TrueClass
                %p.champ-content.fr-mb-0 Oui
              - when FalseClass
                %p.champ-content.fr-mb-0 Non
              - when String
                %p.champ-content.copy-zone.fr-mb-0{ 'data-to-copy': value }
                  %span{ data: { to_copy: true } }= value
                  %span{ 'data-copy-message-placeholder': true }
              - when Array
                %p.champ-content.fr-mb-0
                  - value.map do |row|
                    - if row.is_a?(Hash)
                      - if row['value']
                        %span= row['value']
                      - elsif row['url']
                        %span
                          %a{ href: row['url'], target: '_blank' }= row['visible_name']
              - when Hash
                - if value['value']
                  %p.champ-content.fr-mb-0= value['value']
              - else
                %p.champ-content.fr-mb-0= value.to_s
