-# pf: jumeau OmniAuth de france_connect/confirm_email_merge_password (amont #13065)
.fr-container.fr-my-5w
  .fr-grid-row.fr-col-offset-md-2.fr-col-md-8
    .fr-col-12
      %h1.text-center.fr-mt-2v= t('.title')

      %p= t('.intro_html', email: h(@merge_email), provider: t("omniauth.provider.#{@provider}"))

      = form_tag omniauth_send_email_merge_request_path, method: :post, class: 'fr-mt-4v fconnect-form' do
        = hidden_field_tag :merge_token, @fci.merge_token
        = hidden_field_tag :provider, @provider
        = hidden_field_tag :email, @merge_email

        .fr-input-group{ class: class_names('fr-input-group--error': flash[:alert].present?) }
          = label_tag :password, t('.password_label'), class: 'fr-label'
          = password_field_tag :password, nil, autocomplete: 'current-password', class: 'fr-input', required: true
          - if flash[:alert].present?
            %p.fr-error-text= flash[:alert]

        = submit_tag t('.submit'), class: 'fr-btn'
