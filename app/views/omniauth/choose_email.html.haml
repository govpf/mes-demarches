.fr-container.fr-my-5w
  .fr-grid-row.fr-col-offset-md-2.fr-col-md-8
    .fr-col-12

      %h1.text-center.mt-1= t('.choose_email_contact', provider: t("omniauth.provider.#{@provider}"))

      %p= t('.intro_html', email: @fci.email_france_connect, provider: t("omniauth.provider.#{@provider}"))

      %p= t('.use_email_for_notifications')

      %fieldset.fr-fieldset
        = form_with url: omniauth_merge_using_provider_email_path,
          method: :post,
          data: { controller: 'email-omniauth',
            'email-omniauth-provider-email-path-value': omniauth_merge_using_provider_email_path,
            'email-omniauth-custom-email-path-value': omniauth_send_email_merge_request_path,
            'email-omniauth-target': "form" } do |f|

          = hidden_field_tag :merge_token, @fci.merge_token
          = hidden_field_tag :provider, @provider

          %fieldset.fr-fieldset
            %legend.fr-fieldset__legend
            .fr-fieldset__element
              .fr-radio-group
                = f.radio_button :use_provider_email, true,
                  id: 'use_provider_email_yes',
                  class: 'fr-radio',
                  required: true,
                  data: { action: "email-omniauth#triggerEmailField email-omniauth#triggerSubmitDisabled",
                  'email-omniauth-target': "useProviderEmail" }
                %label.fr-label.fr-text--wrap{ for: 'use_provider_email_yes' }
                  = t('.keep_provider_email_html', email: h(@fci.email_france_connect), provider: t("omniauth.provider.#{@provider}"))

            .fr-fieldset__element
              .fr-radio-group
                = f.radio_button :use_provider_email, false,
                  id: 'use_provider_email_no',
                  class: 'fr-radio',
                  required: true,
                  data: { action: "email-omniauth#triggerEmailField email-omniauth#triggerSubmitDisabled", 'email-omniauth-target': "useProviderEmail" }
                %label.fr-label.fr-text--wrap{ for: 'use_provider_email_no' }
                  = t('.use_another_email')

            .fr-fieldset__element.fr-fieldset__element--inline.hidden{
              aria: { hidden: true },
              data: {
                'email-omniauth-target': "emailField",
                controller: 'email-input',
                'email-input-url-value': show_email_suggestions_path
                }
              }

              = f.label :email, t('.alternative_email'), class: "fr-label"
              %span.fr-hint-text.mb-1= t('activerecord.attributes.user.hints.email')
              = f.email_field :email,
                data: { action: "email-omniauth#triggerSubmitDisabled", 'email-omniauth-target': "emailInput" },
                class: "fr-input"

              .suspect-email.hidden{ data: { "email-input-target": 'ariaRegion'}, aria: { live: 'off' } }
                = render Dsfr::AlertComponent.new(title: t('utils.email_suggest.wanna_say'), state: :info, heading_level: :div) do |c|
                  - c.with_body do
                    %p{ data: { "email-input-target": 'suggestion'} } exemple@gmail.com &nbsp;?
                    %p
                      = button_tag type: 'button', class: 'fr-btn fr-btn--sm fr-mr-3w', data: { action: 'click->email-input#accept'} do
                        = t('utils.yes')
                      = button_tag type: 'button', class: 'fr-btn fr-btn--sm', data: { action: 'click->email-input#discard'} do
                        = t('utils.no')
          %div
            = f.submit t('.confirm'),
              class: 'fr-btn',
              data: { 'email-omniauth-target': "submit" },
              disabled: true
