- content_for(:title, "Sélection de l'établissement")

- content_for :footer do
  = render partial: "users/procedure_footer", locals: { procedure: @dossier.procedure, dossier: @dossier }

.fr-mt-5w
  .container
    %h1 Sélection de l'établissement

    %p
      Nous avons trouvé plusieurs établissements pour le numéro TAHITI
      %strong= @siret_prefix

    %p
      Veuillez sélectionner celui qui correspond à votre activité :

    = render partial: 'users/dossiers/etablissement/etablissements_list',
             locals: { siret_prefix: @siret_prefix, etablissements: @etablissements, dossier: @dossier }

    %ul.fr-mt-2w.fr-mb-5w.fr-btns-group.fr-btns-group--inline
      %li= link_to 'Utiliser un autre numéro TAHITI', siret_dossier_path(@dossier), class: 'fr-btn fr-btn--secondary'
